-- Tables before implementing Delete/Update changes
SELECT * FROM Customers;
SELECT * FROM Orders;
SELECT * FROM Products;
SELECT * FROM OrderItems;
SELECT * FROM Payments;
SELECT * FROM Shipments;

-- Query 1: View all products available in quantities of 30 or more
SELECT * FROM Products WHERE StockQuantity >= 30 ;

-- Query 2: Show average total amount
SELECT AVG(TotalAmount) FROM Orders ;

-- Query 3: View order details with customer information
SELECT o.OrderID, o.OrderDate, o.TotalAmount, c.Name AS CustomerName, c.Email, c.Address
FROM Orders o
JOIN Customers c ON o.CustomerID = c.CustomerID;

-- Query 4: Delete a customer who did not request
DELETE FROM Customers WHERE CustomerID NOT IN (SELECT DISTINCT CustomerID FROM Orders);

-- Query 5: Update Stock Quantity
UPDATE Products SET StockQuantity = 0 WHERE ProductID = 4;

-- Query 6: Updating payment status of a certain order
UPDATE Payments SET PaymentStatus = 'Paid' WHERE OrderID = 2;

-- Query 7: Delete shipments that hasn't been successfully paid for
DELETE FROM Shipments WHERE OrderID = ( SELECT OrderID FROM Payments WHERE PaymentStatus = 'Card declined' );

-- Query 8: Calculate the revenue gained only from paid orders
SELECT SUM(TotalAmount) FROM Orders WHERE NOT OrderID = ( SELECT OrderID FROM Payments WHERE PaymentStatus = 'Card declined' );

-- Query 9: View the successful payments
SELECT * FROM Payments WHERE PaymentStatus = 'Paid';

-- Query 10: View shipment status with order information
SELECT s.ShipmentID, s.ShippingStatus, o.OrderID, o.OrderDate, o.TotalAmount
FROM shipments s
JOIN Orders o ON s.OrderID = o.OrderID;

