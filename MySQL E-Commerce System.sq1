-- Create a product table
CREATE TABLE Products (
  ProductID INT PRIMARY KEY AUTO_INCREMENT,  -- Used to automate redundant ID insertions taking unnecessary space
  Name TEXT NOT NULL,
  Description TEXT ,
  Price DOUBLE NOT NULL,
  StockQuantity INT NOT NULL,
  Category TEXT
);

-- Create a Customer table
CREATE TABLE Customers (
  CustomerID INT PRIMARY KEY AUTO_INCREMENT ,  -- Used to automate redundant ID insertions taking unnecessary space
  Name TEXT NOT NULL ,
  Email TEXT NOT NULL ,
  Phone INT NOT NULL,
  Address TEXT NOT NULL
);

-- Create an Orders table
CREATE TABLE Orders (
  OrderID INT PRIMARY KEY AUTO_INCREMENT,  -- Used to automate redundant ID insertions taking unnecessary space
  OrderDate DATE NOT NULL,
  TotalAmount DOUBLE NULL,
  CustomerID INT NOT NULL, FOREIGN KEY(CustomerID) REFERENCES Customers(CustomerID)
);

-- Create an OrderItems table
CREATE TABLE OrderItems (
  OrderItemID INTEGER PRIMARY KEY AUTO_INCREMENT,  -- Used to automate redundant ID insertions taking unnecessary space
  Quantity INTEGER NOT NULL,
  UnitPrice FLOAT NOT NULL,
  ProductID INTEGER NOT NULL, FOREIGN KEY(ProductID) REFERENCES Products(ProductID),
  OrderID INTEGER NOT NULL, FOREIGN KEY(OrderID) REFERENCES Orders(OrderID)
);

-- Create a Payments  table
CREATE TABLE Payments (
  PaymentID INTEGER PRIMARY KEY AUTO_INCREMENT,  -- Used to automate redundant ID insertions taking unnecessary space
  PaymentDate DATE NOT NULL,
  PaymentMethod TEXT NOT NULL,
  PaymentStatus TEXT NOT NULL,
  OrderID INTEGER NOT NULL, FOREIGN KEY(OrderID) REFERENCES Orders(OrderID)
);


-- Create a Shipments  table
CREATE TABLE Shipments (
  ShipmentID INTEGER PRIMARY KEY AUTO_INCREMENT,  -- Used to automate redundant ID insertions taking unnecessary space
  ShipmentDate DATE NOT NULL,
  ShippingAddress TEXT NOT NULL,
  ShippingStatus TEXT NOT NULL,
  OrderID INTEGER NOT NULL, FOREIGN KEY(OrderID) REFERENCES Orders(OrderID)
);

