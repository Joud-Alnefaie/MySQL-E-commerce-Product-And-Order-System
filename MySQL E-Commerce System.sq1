-- we used this statement to automatically calculate the total amount of each order for each individual customer because we can't always know the price/quantity 
UPDATE Orders SET TotalAmount = ( SELECT SUM(UnitPrice * Quantity) FROM OrderItems WHERE OrderItems.OrderID = Orders.OrderID );


